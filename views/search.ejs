<h1>Search Stocks</h1>

<form method="GET" action="/search">
  <input type="text" name="q" value="<%= query || '' %>" placeholder="Enter ticker (e.g., AAPL)" />
  <button type="submit">Search</button>
</form>

<% if (typeof error !== 'undefined' && error) { %>
    <p style="color:red;"><%= error %></p>
<% } %>

<% if (results && results.length) { %>
  <ul>
    <% results.forEach(stock => { %>
      <li>
        <a href="/ticker/<%= stock.ticker_symbol %>"><%= stock.ticker_symbol %></a> - $<%= Number(stock.current_price).toFixed(2) %>
      </li>
    <% }) %>
  </ul>
<% } else if (query) { %>
  <p>No results found for "<%= query %>"</p>
<% } else { %>
  <p>Enter a ticker symbol above to search stocks.</p>
<% } %>

<div class="back-btn">
    <a href="<%= dashboardPath %>">← Back to Dashboard</a>
</div>