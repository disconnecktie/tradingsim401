<h1>📄 Transaction History</h1>

<% if (error) { %>
  <p class="error-msg"><%= error %></p>
<% } else if (transactions.length === 0) { %>
  <p>No transactions recorded yet.</p>
<% } else { %>
  <table class="transaction-list">
    <thead>
      <tr>
        <th>Type</th>
        <th>Ticker</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% transactions.forEach(t => { %>
        <tr>
          <td><%= t.transaction_type.toUpperCase() %></td>
          <td><%= t.ticker_symbol || '-' %></td>
          <td><%= t.quantity || '-' %></td>
          <td><%= t.price ? '$' + t.price.toFixed(2) : '-' %></td>
          <td><%= t.total ? '$' + t.total.toFixed(2) : '-' %></td>
          <td><%= new Date(t.transaction_time).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<br>
<a href="<%= dashboardPath %>" class="btn">← Back to Dashboard</a>
