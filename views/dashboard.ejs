<h2>Welcome back, <%= user.name || user.email %> 👋</h2>

<% if (typeof isMarketOpen !== 'undefined') { %>
  <div class="market-status <%= isMarketOpen ? 'open' : 'closed' %>">
    <%= isMarketOpen ? '✅ Market is currently OPEN' : '⛔ Market is currently CLOSED' %>
  </div>
<% } %>

<section class="portfolio-summary">
  <h3>Total Portfolio Value</h3>
  <p class="portfolio-value">$<%= totalValueNow.toFixed(2) %></p>
  <% if (percentChange === 0) { %>
    <p class="performance neutral">No change (24h)</p>
  <% } else { %>
    <p class="performance <%= percentChange >= 0 ? 'positive' : 'negative' %>">
      <%= percentChange >= 0 ? '+' : '' %><%= percentChange.toFixed(2) %>% (24h)
    </p>
  <% } %>
</section>

<section class="cash-account">
  <h4>Cash Account</h4>
  <p>Available Cash: $<%= (user.cashBalance || 0).toFixed(2) %></p>
</section>

<section class="portfolio-graph">
  <h4>Performance Graph</h4>
  <div class="view-range-selector">
    <label for="rangeSelect">View Range:</label>
    <select id="rangeSelect">
      <option value="1d">Today</option>
      <option value="5d">Last 5 Days</option>
      <option value="30d">Last 30 Days</option>
    </select>
  </div>

  <canvas id="portfolioChart" width="600" height="300"></canvas>
</section>

<section class="portfolio-stocks">
  <h4>Your Holdings</h4>
  <table>
    <thead>
      <tr>
        <th>Ticker</th>
        <th>Shares</th>
        <th>Value</th>
        <th>Last Buy</th>
      </tr>
    </thead>
    <tbody>
      <% if (holdings.length === 0) { %>
        <tr><td colspan="4">You don't own any stocks yet.</td></tr>
      <% } else { %>
        <% holdings.forEach(h => { %>
          <tr>
            <td><a href="/ticker/<%= h.ticker_symbol %>"><%= h.ticker_symbol %></a></td>
            <td><%= h.quantity %></td>
            <td>$<%= (h.quantity * h.current_price).toFixed(2) %></td>
            <td><%= new Date(h.last_purchase_time).toLocaleString() %></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</section>

<section class="dashboard-links">
  <a href="/search" class="dashboard-btn">🔍 Search Stocks</a>
  <a href="/cash" class="dashboard-btn">💵 Manage Funds</a>
  <a href="/transactions" class="dashboard-btn">📄 View Transactions</a>
</section>

<!-- Load Luxon first -->
<script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>

<!-- Load Chart.js core -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<!-- Load the Chart.js adapter for Luxon -->
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.0/dist/chartjs-adapter-luxon.umd.min.js"></script>

<script>
  let chart;
  let selectedRange = '1d';

  async function renderPortfolioChart(range = '1d') {
    selectedRange = range;
    const res = await fetch(`/api/portfolio/history?range=${range}`);
    const data = await res.json();

    const labels = data.map(d => new Date(d.date));
    const values = data.map(d => d.value);
    const ctx = document.getElementById('portfolioChart').getContext('2d');

    if (chart) chart.destroy();

    chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: 'Portfolio Value',
          data: values,
          borderWidth: 2,
          pointRadius: 2,
          fill: false
        }]
      },
      options: {
        plugins: {
          legend: {
            display: false
          }
        },
        responsive: true,
        scales: {
          x: {
            type: 'time',
            time: {
              unit: selectedRange === '1d' ? 'hour' : 'day'
            },
            ticks: {
              callback: function(value) {
                const date = new Date(value);
                return selectedRange === '1d'
                  ? date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                  : date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
              }
            }
          },
          y: {
            beginAtZero: false
          }
        }
      }
    });
  }

  document.getElementById('rangeSelect').addEventListener('change', (e) => {
    renderPortfolioChart(e.target.value);
  });

  renderPortfolioChart(); // initial render
</script>