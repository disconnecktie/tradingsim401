<h2 id="stock-title"><%= symbol.toUpperCase() %> - Stock Details</h2>
<a href="<%= referer %>">← Back</a>

<section class="stock-summary" id="stock-summary">
  <p><strong>Current Price:</strong> $<span id="current-price">...</span></p>
  <p><strong>Owned Shares:</strong> <%= ownedQuantity %> shares</p>
</section>

<div class="view-range-selector">
  <label for="rangeSelector">View Range:</label>
  <select id="rangeSelector">
    <option value="1d">1 Day</option>
    <option value="5d">5 Days</option>
    <option value="30d" selected>30 Days</option>
  </select>
</div>

<canvas id="priceChart" width="800" height="400"></canvas>

<div class="trade-toggle">
  <button type="button" onclick="showTab('buy')" id="buyBtn" class="active">Buy</button>
  <button type="button" onclick="showTab('sell')" id="sellBtn">Sell</button>
</div>

<div id="buyForm" class="trade-form">
  <h3>Buy Shares</h3>
  <form action="/buy/<%= symbol %>" method="POST">
    <input type="hidden" name="symbol" value="<%= symbol %>">
    
    <label for="buyQty"><strong>Quantity:</strong></label><br>
    <input type="number" id="buyQty" name="quantity" min="1" required><br><br>

    <p><strong>Market Price:</strong> <span id="buy-price">$0.00</span></p>
    <p><strong>Estimated Cost:</strong> <span id="buy-cost">$0.00</span></p>

    <button type="submit" class="dashboard-btn">Buy</button>
  </form>
</div>

<div id="sellForm" class="trade-form" style="display:none;">
  <h3>Sell Shares</h3>
  <form action="/sell/<%= symbol %>" method="POST">
    <input type="hidden" name="symbol" value="<%= symbol %>">
    
    <label for="sellQty"><strong>Quantity:</strong></label><br>
    <input type="number" id="sellQty" name="quantity" min="1" required><br><br>

    <p><strong>Market Price:</strong> <span id="sell-price">$0.00</span></p>
    <p><strong>Estimated Proceeds:</strong> <span id="sell-proceeds">$0.00</span></p>

    <button type="submit" class="dashboard-btn">Sell</button>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const symbol = "<%= symbol %>";
  let chart;

  function loadHistory(range = '30d') {
    fetch(`/api/history/${symbol}?range=${range}`)
      .then(res => res.json())
      .then(data => {
        const labels = data.map(d => new Date(d.recorded_at).toLocaleString());
        const prices = data.map(d => parseFloat(d.price));

        if (chart) {
          chart.data.labels = labels;
          chart.data.datasets[0].data = prices;
          chart.update();
        } else {
          chart = new Chart(document.getElementById('priceChart'), {
            type: 'line',
            data: {
              labels,
              datasets: [{
                label: `${symbol} Price History`,
                data: prices,
                fill: false,
                borderWidth: 2
              }]
            },
            options: {
              plugins: {
                legend: {
                  display: false
                }
              },
              scales: {
                x: { title: { display: true, text: 'Time' }},
                y: { title: { display: true, text: 'Price ($)' }}
              }
            }
          });
        }
      });
  }

  fetch(`/api/stock/${symbol}`)
    .then(res => res.json())
    .then(stock => {
      const price = Number(stock.current_price).toFixed(2);
      document.getElementById('current-price').textContent = price;
      document.getElementById('buy-price').textContent = price;
      document.getElementById('sell-price').textContent = price;

      document.getElementById('buyQty').addEventListener('input', () => {
        const qty = parseInt(document.getElementById('buyQty').value) || 0;
        document.getElementById('buy-cost').textContent = (qty * price).toFixed(2);
      });

      document.getElementById('sellQty').addEventListener('input', () => {
        const qty = parseInt(document.getElementById('sellQty').value) || 0;
        document.getElementById('sell-proceeds').textContent = (qty * price).toFixed(2);
      });
    });

  document.getElementById('rangeSelector').addEventListener('change', e => {
    loadHistory(e.target.value);
  });

  loadHistory(); // Initial load

  function showTab(tab) {
    document.getElementById('buyForm').style.display = tab === 'buy' ? 'block' : 'none';
    document.getElementById('sellForm').style.display = tab === 'sell' ? 'block' : 'none';

    document.getElementById('buyBtn').classList.toggle('active', tab === 'buy');
    document.getElementById('sellBtn').classList.toggle('active', tab === 'sell');
  }

  // Disable sell if user owns no shares
  document.addEventListener('DOMContentLoaded', () => {
  const ownedShares = <%= ownedQuantity %>;

  if (ownedShares <= 0) {
    // Option 1: Hide the Sell button completely
    document.getElementById('sellBtn').style.display = 'none';
    
    // Optionally, also hide Sell form to be super clean
    document.getElementById('sellForm').style.display = 'none';
  }
  });

  document.addEventListener('DOMContentLoaded', () => {
  const marketOpen = <%= marketOpen ? 'true' : 'false' %>;

  if (!marketOpen) {
    document.querySelectorAll('.trade-form input, .trade-form button').forEach(el => {
      el.disabled = true;
    });

    const forms = document.querySelectorAll('.trade-form form');
    forms.forEach(form => {
      const notice = document.createElement('p');
      notice.style.color = 'red';
      notice.style.fontWeight = 'bold';
      notice.style.marginTop = '0.5rem';
      notice.textContent = 'Market is closed. Trading unavailable.';
      form.prepend(notice);
    });
  }
});

</script>