<h1>📈 Create New Stock</h1>

<% if (flash) { %>
  <p class="flash-msg"><%= flash %></p>
<% } %>

<form action="/admin/create-stock" method="POST" class="market-hours-form">
  <label for="ticker_symbol">Ticker Symbol:</label>
  <input type="text" id="ticker_symbol" name="ticker_symbol" maxlength="10" required>

  <label for="current_price">Initial Price ($):</label>
  <input type="number" id="current_price" name="current_price" step="0.01" min="0.01" required>

  <label for="volume">Total Shares (Volume):</label>
  <input type="number" id="volume" name="volume" min="0" required>

  <button type="submit">Create Stock</button>
</form>

<br>
<a href="<%= dashboardPath %>" class="btn">← Back to Admin Panel</a>