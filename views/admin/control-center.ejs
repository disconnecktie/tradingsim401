<h1>🛡️ System Control Center</h1>

<section class="control-card">
  <h2>👥 Manage Users</h2>
  <p>View and manage all user accounts in the system.</p>
  <a href="/admin/manage-users" class="btn">Manage Admins</a>
</section>

<section class="control-card">
  <h2>⚙️ System Settings</h2>
  <p>Configure global trading parameters, environment flags, or system notices.</p>
  <button disabled class="btn btn-disabled">Coming Soon</button>
</section>

<section class="control-card">
  <h2>📜 System Logs & Activity</h2>
  <p>Audit actions from other administrators and users.</p>
  <a href="/admin/activity-log" class="btn">View Log</a>
</section>

<section class="control-card">
  <h2>🚫 System Lockdown</h2>
  <p>Temporarily disable stock trading in case of emergencies or scheduled maintenance.</p>
  <button disabled class="btn btn-disabled">Lock Trading (Coming Soon)</button>
</section>

<section class="control-card">
  <h2>🕒 Force Market Controls</h2>
  <form action="/toggle-market" method="POST">
    <input type="hidden" name="forceOpen" value="1">
    <button type="submit" class="btn">Force Market Open</button>
  </form>

  <form action="/toggle-market" method="POST" style="margin-top:10px;">
    <input type="hidden" name="forceOpen" value="0">
    <button type="submit" class="btn">Revert Market Back to Normal</button>
  </form>
</section>